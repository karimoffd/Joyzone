# Copy to .env.docker (git-ignored) and fill in real values.
# docker compose --env-file .env.docker up -d --build

POSTGRES_DB=joyzone
POSTGRES_USER=joyzone
POSTGRES_PASSWORD=change-me-strong-password
WEB_PORT=8080

DEBUG=False
SECRET_KEY=replace-with-at-least-32-random-characters
ALLOWED_HOSTS=joyzone.uz,www.joyzone.uz,localhost
CSRF_TRUSTED_ORIGINS=https://joyzone.uz,https://www.joyzone.uz
CORS_ALLOWED_ORIGINS=https://joyzone.uz,https://www.joyzone.uz
FRONTEND_BASE_URL=https://joyzone.uz

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
JWT_REFRESH_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Not integrated yet: OTP sending returns 503 until an SMS provider is set.
SMS_PROVIDER=
# Keep test payments off on a real database.
TEST_PAYMENTS_ENABLED=False
