# Joyzone Django backend environment example
# Copy this file to django_backend/.env (loaded automatically) or set the
# variables in the real environment. Real environment variables win.

# Dev default exists in settings.py, but production must provide a unique secret.
SECRET_KEY=change-me-in-production

# Local development can stay true. Production must be false.
DEBUG=True

# Enables the fixed 111111 OTP and dev-admin-login only when DEBUG=True.
# Set this explicitly only for isolated local smoke/E2E environments.
DEV_OTP_ENABLED=True

# Stored OTP lifetime in seconds. A code is expired exactly at this age.
OTP_TTL_SECONDS=300

# Per-IP limits remain hard-coded at send=3/minute and verify=5/minute.
# These additional limits follow the normalized login across changing IPs.
OTP_SEND_ACCOUNT_RATE=3/minute
OTP_VERIFY_ACCOUNT_RATE=5/minute

# Explicit local-only switch. Production logs never contain OTP values.
DEV_OTP_CONSOLE_LOG_ENABLED=False

# Empty uses process-local memory and is suitable only for one local worker.
# Multi-worker/staged deployments must use a shared Redis cache.
CACHE_URL=
CACHE_KEY_PREFIX=joyzone

# Public test-stand access is independent from DEBUG and disabled by default.
# Enable it only on a dedicated disposable database after creating random
# public_demo_* client/partner accounts. Never put account passwords here in a
# frontend VITE_* variable or source file.
PUBLIC_DEMO_LOGIN_ENABLED=False
PUBLIC_DEMO_DATA_ISOLATED=False
PUBLIC_DEMO_ACCOUNT_USERNAMES=
PUBLIC_DEMO_ACCOUNT_PREFIX=public_demo_
PUBLIC_DEMO_LOGIN_EXPIRES_AT=
PUBLIC_DEMO_SESSION_MINUTES=30
PUBLIC_DEMO_LOGIN_RATE=5/minute

# SMS delivery for OTP is not integrated yet. With DEBUG=False the API refuses
# to issue OTP codes until a provider is configured here.
SMS_PROVIDER=

# Test payments mark bookings/tariffs paid without money. Default: same as
# DEBUG. Never enable on a production database.
TEST_PAYMENTS_ENABLED=True

# Business timezone for daily bookings, availability and discounts.
TIME_ZONE=Asia/Tashkent

# Global API rate limits (per IP for anonymous users, per user otherwise).
API_ANON_RATE=300/minute
API_USER_RATE=1200/minute

# Refresh tokens are sent only as an httpOnly cookie. The frontend and API must
# be same-site (joyzone.uz + api.joyzone.uz). Secure defaults to !DEBUG.
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Lax
JWT_REFRESH_COOKIE_DOMAIN=
JWT_REFRESH_IN_BODY=False

# JWT session policy. Access tokens are deliberately short-lived. Refresh
# tokens rotate on use and the consumed token is blacklisted.
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Comma-separated hosts. Local dev can use localhost/127.0.0.1.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local HTTP-friendly security defaults. Use the production example below on
# a deployed HTTPS environment.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
CSRF_TRUSTED_ORIGINS=

# Production example:
# DEBUG=False
# TEST_PAYMENTS_ENABLED=False
# JWT_REFRESH_COOKIE_SECURE=True
# SECRET_KEY=replace-with-at-least-32-random-characters
# DEV_OTP_ENABLED=False
# DEV_OTP_CONSOLE_LOG_ENABLED=False
# CACHE_URL=redis://127.0.0.1:6379/1
# PUBLIC_DEMO_LOGIN_ENABLED=False
# PUBLIC_DEMO_DATA_ISOLATED=False
# JWT_ACCESS_TOKEN_MINUTES=15
# JWT_REFRESH_TOKEN_DAYS=7
# ALLOWED_HOSTS=api.joyzone.uz
# CORS_ALLOWED_ORIGINS=https://joyzone.uz,https://www.joyzone.uz
# CORS_ALLOW_ALL_ORIGINS=False
# CSRF_TRUSTED_ORIGINS=https://joyzone.uz,https://www.joyzone.uz
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# Production import fails when SECRET_KEY/ALLOWED_HOSTS are missing, when the
# development secret is reused, or when hosts/origins contain wildcards.

# Static/media paths and URLs. Local defaults are shown here.
MEDIA_ROOT=media
MEDIA_URL=/media/
STATIC_ROOT=staticfiles
STATIC_URL=/static/

# Image upload policy (bytes and comma-separated MIME types/extensions).
MAX_IMAGE_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/png,image/webp
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp

# Optional dotted Django storage backends. Keep these unset for local disk.
# Installing/configuring an S3-compatible backend is a separate deployment step.
# MEDIA_STORAGE_BACKEND=storages.backends.s3.S3Storage
# STATICFILES_STORAGE_BACKEND=django.contrib.staticfiles.storage.ManifestStaticFilesStorage

# Leave DATABASE_URL empty for local SQLite development/demo.
DATABASE_URL=

# Production example (URL-encode special characters in credentials):
# DATABASE_URL=postgresql://joyzone:change-me@localhost:5432/joyzone?sslmode=require

# Optional PostgreSQL connection tuning. These are ignored by SQLite.
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# Optional SQLite path override used by isolated local/E2E databases.
SQLITE_PATH=db.sqlite3

# Public frontend origin used for absolute URLs in /sitemap.xml.
FRONTEND_BASE_URL=http://localhost:5173
